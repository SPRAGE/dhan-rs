# DhanHQ sandbox credentials
#
# Create a private, sourceable copy with:
#   install -m 600 .env.sandbox.example .env.sandbox
#
# Edit .env.sandbox, then let direnv load it into this repository's shell:
#   direnv allow
#   direnv reload
#
# The populated .env.sandbox file is ignored by Git. Do not commit or paste
# these values into logs, issues, or chat. Dhan access tokens are short-lived;
# replace the value when the token expires.

export DHAN_SANDBOX_CLIENT_ID=""
export DHAN_SANDBOX_ACCESS_TOKEN=""

# Mutation tests remain disabled unless this is supplied for one intentional
# command. Do not enable it permanently in this file:
# export DHAN_SANDBOX_ALLOW_MUTATIONS="I_ACKNOWLEDGE_SANDBOX_ORDER_MUTATIONS"

# tests/sandbox.rs pins requests to https://sandbox.dhan.co. A Postback URL is
# optional and is not read by the sandbox test suite.
