use flake

# Sandbox-only credentials live in a private, gitignored file. Keeping this
# optional lets contributors use the development shell without Dhan credentials.
if [[ -f .env.sandbox ]]; then
  sandbox_env_mode="$(stat -c '%a' .env.sandbox)"
  if [[ "$sandbox_env_mode" != "600" ]]; then
    log_error ".env.sandbox must have mode 0600; run: chmod 600 .env.sandbox"
    return 1
  fi
  source_env .env.sandbox

  # Compatibility for private files created from the original template. The
  # test process receives sandbox-specific names, never ambiguous broker names.
  if [[ -z "${DHAN_SANDBOX_CLIENT_ID:-}" && -z "${DHAN_SANDBOX_ACCESS_TOKEN:-}" && -n "${DHAN_CLIENT_ID:-}" && -n "${DHAN_ACCESS_TOKEN:-}" ]]; then
    export DHAN_SANDBOX_CLIENT_ID="$DHAN_CLIENT_ID"
    export DHAN_SANDBOX_ACCESS_TOKEN="$DHAN_ACCESS_TOKEN"
  fi
  unset DHAN_CLIENT_ID DHAN_ACCESS_TOKEN
fi

# A mutation acknowledgement is intentionally one-command-only. Even if it is
# accidentally added to .env.sandbox, direnv will not persist it.
unset DHAN_SANDBOX_ALLOW_MUTATIONS
